#!/usr/bin/env bash
# ==============================================================================
# Vivaldi Sidebar Mod - Automated Persistence Hook
# Triggers after any apt/dpkg package manager transaction, inotify path event,
# or pre-launch trigger.
# Automatically detects if Vivaldi was updated and re-applies patches silently.
# ==============================================================================
set -euo pipefail

VIVALDI_DIR="/opt/vivaldi/resources/vivaldi"
SYSTEM_SHARE_DIR="/usr/local/share/vivaldi-sidebar-mod"
INSTALL_DIR="/home/lucifer/Documents/Projects/vivaldi-sidebar-fix"

# Candidate source directories for mod assets
SOURCE_DIR=""
if [ -d "$SYSTEM_SHARE_DIR/src" ] && [ -f "$SYSTEM_SHARE_DIR/src/edge-panel-mod.js" ]; then
    SOURCE_DIR="$SYSTEM_SHARE_DIR"
elif [ -d "$INSTALL_DIR/src" ] && [ -f "$INSTALL_DIR/src/edge-panel-mod.js" ]; then
    SOURCE_DIR="$INSTALL_DIR"
fi

# If Vivaldi is not installed or sources cannot be found, exit cleanly
[ -d "$VIVALDI_DIR" ] || exit 0
[ -f "$VIVALDI_DIR/window.html" ] || exit 0
[ -f "$VIVALDI_DIR/bundle.js" ] || exit 0
[ -n "$SOURCE_DIR" ] || exit 0

NEEDS_REINSTALL=0

# Check 1: Is edge-panel-mod.js script tag missing from window.html?
if ! grep -Fq "edge-panel-mod.js" "$VIVALDI_DIR/window.html"; then
    NEEDS_REINSTALL=1
# Check 2: Is __edgeCloseWebPanel missing from bundle.js?
elif ! grep -Fq "__edgeCloseWebPanel" "$VIVALDI_DIR/bundle.js"; then
    NEEDS_REINSTALL=1
# Check 3: Is __edgeShouldReset missing from bundle.js?
elif ! grep -Fq "__edgeShouldReset" "$VIVALDI_DIR/bundle.js"; then
    NEEDS_REINSTALL=1
# Check 4: Is 88% width missing from bundle.js?
elif ! grep -Fq ".880*this.context.innerWidth" "$VIVALDI_DIR/bundle.js"; then
    NEEDS_REINSTALL=1
fi

if [ "$NEEDS_REINSTALL" -eq 1 ]; then
    # Step 1: Copy edge-panel-mod.js
    cp -f "$SOURCE_DIR/src/edge-panel-mod.js" "$VIVALDI_DIR/edge-panel-mod.js"
    chmod 644 "$VIVALDI_DIR/edge-panel-mod.js"

    # Step 2: Inject script tag into window.html
    if ! grep -Fq 'src="edge-panel-mod.js"' "$VIVALDI_DIR/window.html"; then
        sed -i.bak 's|</body>|<script src="edge-panel-mod.js"></script></body>|' "$VIVALDI_DIR/window.html"
        rm -f "$VIVALDI_DIR/window.html.bak"
    fi

    # Step 3: Run patch-bundle.py
    if [ -f "$SOURCE_DIR/src/patch-bundle.py" ]; then
        python3 "$SOURCE_DIR/src/patch-bundle.py" "$VIVALDI_DIR/bundle.js" >/dev/null 2>&1 || true
    fi
fi

exit 0
